# Si usas Supabase, usa el "Connection pooler" (Session pooler, puerto 5432) en vez de la
# conexión directa "db.<ref>.supabase.co" — esa suele fallar por DNS/IPv4 en muchas redes.
# La encuentras en: Project Settings > Database > Connection string > Session pooler.
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN_SECONDS=604800
PORT=3000
# En producción, pon aquí la URL exacta de tu frontend desplegado (ej. https://tu-app.netlify.app)
CORS_ORIGINS="http://localhost:4200"

# Notificaciones por correo de pagos recurrentes (usa Resend: https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="MisFinanzas <onboarding@resend.dev>"
# Secreto compartido para el endpoint POST /api/recurring-payments-notifications/run
# (llamado por un cron externo, ej. GitHub Actions). Genera uno aleatorio y largo.
CRON_SECRET="change-this-to-a-long-random-string"
