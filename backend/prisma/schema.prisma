generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  CREDIT_CARD
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  ADMIN
  USER
}

enum RuleField {
  ANY
  DESCRIPTION
  MERCHANT
}

enum RuleOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
}

model CategorizationRule {
  id         String       @id @default(uuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  field      RuleField
  operator   RuleOperator
  pattern    String
  priority   Int          @default(100)
  active     Boolean      @default(true)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  account    Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, priority])
  @@index([categoryId])
  @@index([accountId])
}

enum AuthLinkPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

model AccountSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authVersion Int
  label       String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId, revokedAt, expiresAt])
}

model AuthLink {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose         AuthLinkPurpose
  tokenHash       String          @unique
  email           String
  authVersion     Int
  expiresAt       DateTime
  consumedAt      DateTime?
  issuedAt        DateTime        @default(now())
  windowStartedAt DateTime        @default(now())
  sentInWindow    Int             @default(1)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

model User {
  authVersion Int @default(0)
  emailVerifiedAt DateTime?
  sessions AccountSession[]
  authLinks AuthLink[]
  id                     String        @id @default(uuid())
  email                  String        @unique
  passwordHash           String
  name                   String
  role                   UserRole      @default(USER)
  lastMonthlySummaryFor  DateTime?     @db.Date
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  expenseDocuments ExpenseDocument[]
  quickEntryRequests QuickEntryRequest[]
  documentUploads DocumentUpload[]
  categorizationRules CategorizationRule[]
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  transfers         Transfer[]
  importBatches     ImportBatch[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]
  savingsGoals      SavingsGoal[]
}

model Account {
  id             String        @id @default(uuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  type           AccountType
  institution    String?
  currency       String        @default("COP")
  initialBalance Decimal       @default(0) @db.Decimal(14, 2)
  color          String?
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  recurringPayments RecurringPayment[]

  cardProfile       CardProfile? @relation("CardAccount")
  cardsPaidFrom     CardProfile[] @relation("CardPaymentSource")
  cardStatements    CardStatement[]
  categorizationRules CategorizationRule[]
  outgoingTransfers Transfer[] @relation("TransferSource")
  incomingTransfers Transfer[] @relation("TransferDestination")
  importBatches     ImportBatch[]

  @@index([userId])
}

model CardProfile {
  accountId        String   @id
  account          Account  @relation("CardAccount", fields: [accountId], references: [id], onDelete: Cascade)
  creditLimit      Decimal  @db.Decimal(14, 2)
  closingDay       Int
  paymentDay       Int
  paymentAccountId String?
  paymentAccount   Account? @relation("CardPaymentSource", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  updatedAt        DateTime @updatedAt

  @@index([paymentAccountId])
}

model CardStatement {
  id                 String   @id @default(uuid())
  cardAccountId      String
  cardAccount        Account  @relation(fields: [cardAccountId], references: [id], onDelete: Cascade)
  closingDate        DateTime @db.Date
  dueDate            DateTime @db.Date
  plannedPaymentDate DateTime? @db.Date
  total              Decimal  @db.Decimal(14, 2)
  minimumPayment     Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  payments           Transfer[]

  @@unique([cardAccountId, closingDate])
  @@index([dueDate])
}

model Category {
  id           String           @id @default(uuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  type         TransactionType
  icon         String?
  color        String?
  parent       Category?        @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  parentId     String?
  categorizationRules CategorizationRule[]
  subcategories Category[]      @relation("CategoryToSubcategory")
  transactions Transaction[]
  budgets      Budget[]
  recurringPayments RecurringPayment[]
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@unique([userId, name, parentId])
}

model Transaction {
  id            String           @id @default(uuid())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?
  type          TransactionType
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("COP")
  date          DateTime
  merchant      String?
  description   String?
  paymentMethod String?
  tags          String[]         @default([])
  isRecurring   Boolean          @default(false)
  notes         String?
  externalRef   String?
  transfer      Transfer?        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId    String?
  importBatch   ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importBatchId String?
  expenseDocuments ExpenseDocument[]
  quickEntryRequest QuickEntryRequest?
  documentUploads DocumentUpload[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, externalRef])
  @@unique([transferId, type])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([importBatchId])
}

model QuickEntryRequest {
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId     String @db.Uuid
  contentHash   String
  transactionId String? @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@id([userId, requestId])
}

model ExpenseDocument {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  size          Int
  sha256        String
  data          Bytes
  createdAt     DateTime @default(now())

  @@unique([transactionId, sha256])
  @@index([userId])
}

model DocumentUpload {
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId     String @db.Uuid
  contentHash   String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  documentIds   String[]
  createdAt     DateTime @default(now())

  @@id([userId, requestId])
  @@index([transactionId])
}

model ImportBatch {
  id            String        @id @default(uuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  requestId     String        @db.Uuid
  contentHash   String
  fileName      String
  total         Int
  imported      Int
  skipped       Int
  createdAt     DateTime      @default(now())
  transactions  Transaction[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([accountId])
}

model Transfer {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  fromAccount       Account       @relation("TransferSource", fields: [fromAccountId], references: [id], onDelete: NoAction)
  fromAccountId     String
  toAccount         Account       @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: NoAction)
  toAccountId       String
  amount            Decimal       @db.Decimal(14, 2)
  destinationAmount Decimal       @db.Decimal(14, 2)
  cardStatementId   String?
  cardStatement     CardStatement? @relation(fields: [cardStatementId], references: [id], onDelete: NoAction)
  date              DateTime      @db.Date
  description       String?
  requestId         String        @db.Uuid
  createdAt         DateTime      @default(now())
  transactions      Transaction[]

  @@unique([userId, requestId])
  @@index([userId, date])
  @@index([cardStatementId])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Budget {
  id                  String    @id @default(uuid())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId          String
  amount              Decimal   @db.Decimal(14, 2)
  lastAlertMonth      DateTime? @db.Date
  lastAlertPercentage Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model RecurringPayment {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  name       String
  amount     Decimal   @db.Decimal(14, 2)
  dueDay     Int
  active     Boolean   @default(true)
  lastNotifiedFor DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model SavingsGoal {
  id            String                @id @default(uuid())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String
  targetAmount  Decimal               @db.Decimal(14, 2)
  targetDate    DateTime?             @db.Date
  color         String?
  archived      Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contributions SavingsContribution[]

  @@index([userId])
}

model SavingsContribution {
  id        String      @id @default(uuid())
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    String
  amount    Decimal     @db.Decimal(14, 2)
  date      DateTime    @db.Date
  note      String?
  createdAt DateTime    @default(now())

  @@index([goalId])
}
